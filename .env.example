PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Anti-spam HMAC shared with the Apps Script backend (code.gs).
# WARNING: this value ships in the client bundle — it is obfuscation, NOT auth.
# The backend MUST enforce its own rate limits and never trust ipHash/fpHash
# (both are client-reported and trivially spoofable).
PUBLIC_CONTACT_SECRET=YOUR_SHARED_SECRET
