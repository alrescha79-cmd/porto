---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "../lib/utils"

type Props = {
  entry: CollectionEntry<"projects">;
};

const { entry } = Astro.props
const { collection, data, body } = entry
  const { title, summary, date, demoUrl, repoUrl, coverImage } = data;
---

<div>
  <a
    href={`/${collection}`}
    class="group w-fit px-3.5 py-1.5 gap-2 text-xs font-semibold flex items-center border rounded-full bg-white dark:bg-neutral-900/40 hover:bg-black/5 hover:dark:bg-white/10 border-black/[0.08] dark:border-white/[0.12] transition-all duration-200 ease-out active:scale-95 text-black/75 dark:text-white/75"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white transition-transform duration-200 ease-out group-hover:-translate-x-0.5"
    >
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span
      class="group-hover:text-black group-hover:dark:text-white transition-colors duration-200 ease-out capitalize"
    >
      Back to {collection}
    </span>
  </a>
  <div class="flex flex-wrap text-xs font-mono uppercase mt-8 gap-4 text-black/60 dark:text-white/60">
    <div class="flex items-center gap-1.5">
      <svg class="size-4 stroke-current">
        <use href="/ui.svg#calendar"></use>
      </svg>
      {formatDate(date)}
    </div>
    <div class="flex items-center gap-1.5">
      <svg class="size-4 stroke-current">
        <use href="/ui.svg#book-open"></use>
      </svg>
      {readingTime(body ?? "")}
    </div>
  </div>
  <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-black dark:text-white mt-3">
    {title}
  </h1>
  <div class="mt-2 text-sm md:text-base text-black/75 dark:text-white/75 leading-relaxed">
    {summary}
  </div>
  {coverImage && (
    <img
      src={coverImage}
      alt={title}
      class="mt-6 w-full rounded-lg border border-black/[0.08] object-cover dark:border-white/[0.12]"
      loading="lazy"
    />
  )}
  {
    (demoUrl || repoUrl) && (
      <div class="mt-5 flex flex-wrap gap-2.5">
        {demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex gap-2 items-center px-4 py-2 rounded-full text-xs md:text-sm font-semibold bg-black dark:bg-white text-white dark:text-black hover:opacity-90 transition-all duration-200 ease-out active:scale-95 shadow-xs"
          >
            <svg class="size-4 fill-current">
              <use href="/ui.svg#globe" />
            </svg>
            <span>Preview</span>
          </a>
        )}
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex gap-2 items-center px-4 py-2 rounded-full text-xs md:text-sm font-semibold border border-black/20 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/10 text-black dark:text-white transition-all duration-200 ease-out active:scale-95 shadow-xs"
          >
            <svg class="size-4 fill-current">
              <use href="/ui.svg#link" />
            </svg>
            <span>Source Code</span>
          </a>
        )}
      </div>
    )
  }
</div>
