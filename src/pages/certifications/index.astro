---
import PageLayout from "../../layouts/PageLayout.astro"
import { CERTIFICATIONS } from "../../consts"
import { certificateData, sortedCertificates } from "../../data"
import Certificates from "../../components/Certificates.astro"
const filtered = sortedCertificates(certificateData)

---

<PageLayout
  title={CERTIFICATIONS.TITLE}
  description={CERTIFICATIONS.DESCRIPTION}
>
  <div class="animate pt-24 md:pt-32 pb-12">
    <div class="max-w-4xl mx-auto px-4 text-center mb-8">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-black dark:text-white mb-3">
        {CERTIFICATIONS.TITLE}
      </h1>
      <p class="text-sm md:text-base opacity-75 max-w-xl mx-auto">
        {CERTIFICATIONS.DESCRIPTION}
      </p>
    </div>
    <Certificates certificates={filtered} />
  </div>
</PageLayout>
