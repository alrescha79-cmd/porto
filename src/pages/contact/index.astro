---
import PageLayout from "../../layouts/PageLayout.astro"
import TopLayout from "../../layouts/TopLayout.astro"
import BottomLayout from "../../layouts/BottomLayout.astro"
import { CONTACT } from "../../consts"
import FormContact from "../../components/FormContact.astro"
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <TopLayout>
    <div class="animate space-y-2">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-black dark:text-white">
        {CONTACT.TITLE}
      </h1>
      <p class="text-sm md:text-base opacity-75">
        {CONTACT.DESCRIPTION}
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <FormContact />
  </BottomLayout>
</PageLayout>
