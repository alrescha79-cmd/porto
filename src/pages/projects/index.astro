---
// projects/index.astro
import { getCollection } from "astro:content"
import PageLayout from "../../layouts/PageLayout.astro"
import TopLayout from "../../layouts/TopLayout.astro"
import BottomLayout from "../../layouts/BottomLayout.astro"
import Projects from "../../components/Projects.astro"
import { PROJECTS } from "../../consts"

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const tags = [...new Set(projects.flatMap(project => project.data.tags))]
  .sort((a, b) => a.localeCompare(b))
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <TopLayout>
    <div class="animate space-y-2">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-black dark:text-white">
        {PROJECTS.TITLE}
      </h1>
      <p class="text-sm md:text-base opacity-75">
        {PROJECTS.DESCRIPTION}
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Projects tags={tags} data={projects} />
    </div>
  </BottomLayout>
</PageLayout>

