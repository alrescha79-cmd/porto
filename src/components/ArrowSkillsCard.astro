---
interface Item {
  name: string
}

type Props = {
  title: string
  items: Item[]
}

const { title, items } = Astro.props
---

<div class="p-4 sm:p-5 flex flex-col items-start border rounded-2xl bg-white dark:bg-neutral-900/40 hover:bg-black/[0.02] hover:dark:bg-white/[0.04] border-black/[0.08] dark:border-white/[0.12] hover:border-black/20 dark:hover:border-white/25 transition-all duration-200 ease-out shadow-xs hover:shadow-md">
  <div class="w-full flex flex-col">
    <p class="font-bold text-sm sm:text-base text-black dark:text-white mb-2.5">
      {title}
    </p>
    <ul class="flex flex-wrap gap-1.5">
      {items.map((item) => (
        <li class="text-[11px] font-medium uppercase py-0.5 px-2.5 rounded-md bg-black/[0.04] dark:bg-white/[0.08] border border-black/[0.06] dark:border-white/[0.08] text-black/75 dark:text-white/75">
          {item.name}
        </li>
      ))}
    </ul>
  </div>
</div>