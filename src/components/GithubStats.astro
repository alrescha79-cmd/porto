---
// GitHub Stats component
---

<section class="animate space-y-4">
  <div class="flex justify-between items-center pb-3 border-b border-black/[0.08] dark:border-white/[0.12]">
    <h2 class="text-xl font-bold tracking-tight text-black dark:text-white">GitHub Stats</h2>
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/alrescha79-cmd"
      class="group text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5 text-black/75 dark:text-white/75 hover:text-black dark:hover:text-white transition-colors duration-200"
    >
      <span>alrescha79-cmd</span>
      <svg class="size-3.5 fill-current transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24">
        <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>

  <div class="flex flex-wrap gap-2 pt-1">
    <img
      src="https://visitor-badge.laobi.icu/badge?page_id=alrescha79-cmd.alrescha79-cmd&label=Profile%20Views&left_color=gray&right_color=green"
      alt="visitor-badge"
      width={100}
      height={20}
      loading="lazy"
      class="rounded"
    />
    <img
      src="https://badges.pufler.dev/repos/alrescha79-cmd"
      alt="repo-badge"
      width={100}
      height={20}
      loading="lazy"
      class="rounded"
    />
    <img
      src="https://badges.pufler.dev/commits/monthly/alrescha79-cmd"
      alt="commits-badge"
      width={125}
      height={20}
      loading="lazy"
      class="rounded"
    />
  </div>

  <div class="flex flex-col gap-3.5 pt-1">
    <img
      src="https://streak-stats.demolab.com?user=alrescha79-cmd&theme=microsoft-dark"
      alt="streak graph dark"
      width={725}
      height={175}
      loading="lazy"
      class="dark:block hidden w-full rounded-2xl border border-white/[0.12] shadow-xs"
    />
    <img
      src="https://streak-stats.demolab.com?user=alrescha79-cmd&locale=en&mode=daily&theme=whatsapp-light&hide_border=false&border_radius=16&order=3"
      alt="streak graph light"
      width={725}
      height={175}
      loading="lazy"
      class="block dark:hidden w-full rounded-2xl border border-black/[0.08] shadow-xs"
    />
    <img
      src="https://github-readme-activity-graph.vercel.app/graph?username=alrescha79-cmd&bg_color=000000&color=ffffff&line=333333&point=fffafa&area=true&radius=16"
      alt="activity graph dark"
      width={725}
      height={400}
      loading="lazy"
      class="dark:block hidden w-full border border-white/[0.12] rounded-2xl shadow-xs"
    />
    <img
      src="https://github-readme-activity-graph.vercel.app/graph?username=alrescha79-cmd&bg_color=fffafa&color=000000&line=cccccc&point=000000&area=true&radius=16"
      alt="activity graph light"
      width={725}
      height={400}
      loading="lazy"
      class="block dark:hidden w-full border border-black/[0.08] rounded-2xl shadow-xs"
    />
  </div>
</section>
