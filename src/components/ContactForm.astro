---
const { uid } = Astro.props
---

<div data-contact-form class="w-full" data-uid={uid}>
  <div class="contact-alert alert hidden mb-4 transition duration-300 ease-in-out"></div>

  <form class="contact-form space-y-4 mt-8">
    <div class="relative">
      <input
        type="text"
        id={`name-${uid}`}
        name="from_name"
        required
        placeholder="Name"
        class="block border-2 bg-neutral-100 dark:bg-neutral-800 px-2.5 pb-2.5 pt-4 w-full text-base rounded-md peer shadow-md focus:outline-none focus:ring-0 focus:border-black/70 dark:focus:border-white/80 dark:border-white/20"
      />
      <label
        for={`name-${uid}`}
        class="absolute text-base text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] bg-neutral-100 dark:bg-neutral-800 px-2 peer-focus:px-2 placeholder-opacity-50 peer-placeholder-shown:placeholder-opacity-100 peer-placeholder-shown:scale-100 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:top-1/2 peer-focus:top-2 peer-focus:scale-75 peer-focus:-translate-y-4 start-1 cursor-text rounded-md"
      >
        Full Name
      </label>
    </div>

    <div class="relative">
      <input
        type="email"
        id={`email-${uid}`}
        name="from_email"
        required
        placeholder="Email"
        class="block border-2 bg-neutral-100 dark:bg-neutral-800 px-2.5 pb-2.5 pt-4 w-full text-base rounded-md peer shadow-md focus:outline-none focus:ring-0 focus:border-black/70 dark:focus:border-white/80 dark:border-white/20"
      />
      <label
        for={`email-${uid}`}
        class="absolute text-base text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] bg-neutral-100 dark:bg-neutral-800 px-2 peer-focus:px-2 placeholder-opacity-50 peer-placeholder-shown:placeholder-opacity-100 peer-placeholder-shown:scale-100 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:top-1/2 peer-focus:top-2 peer-focus:scale-75 peer-focus:-translate-y-4 start-1 cursor-text rounded-md"
      >
        Email
      </label>
    </div>

    <div class="relative">
      <textarea
        id={`message-${uid}`}
        name="message"
        rows="6"
        required
        placeholder="Message"
        class="block border-2 bg-neutral-100 dark:bg-neutral-800 px-2.5 pb-2.5 pt-4 w-full text-base rounded-md peer shadow-md focus:outline-none focus:ring-0 focus:border-black/70 dark:focus:border-white/80 dark:border-white/20"
      ></textarea>
      <label
        for={`message-${uid}`}
        class="absolute text-base text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] bg-neutral-100 dark:bg-neutral-800 px-2 peer-focus:px-2 placeholder-opacity-50 peer-placeholder-shown:placeholder-opacity-100 peer-placeholder-shown:scale-100 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:top-7 peer-focus:top-2 peer-focus:scale-75 peer-focus:-translate-y-4 start-1 cursor-text rounded-md"
      >
        Message
      </label>
    </div>

    <button
      type="submit"
      class="flex items-center justify-center text-white dark:text-black bg-black/85 hover:bg-black dark:bg-white/85 dark:hover:bg-white font-semibold rounded-md text-sm px-4 py-3 w-full cursor-pointer duration-100 transition disabled:bg-opacity-45 dark:disabled:bg-opacity-45 disabled:cursor-not-allowed"
    >
      <span class="contact-label">Send</span>
      <span class="contact-loading loading loading-dots loading-sm ml-2 hidden"></span>
    </button>
  </form>
</div>

<script>
  const ENDPOINT = import.meta.env.PUBLIC_APPS_SCRIPT_URL || ""
  const SECRET = import.meta.env.PUBLIC_CONTACT_SECRET || ""

  const b64url = (bytes: Uint8Array) => {
    let bin = ""
    bytes.forEach((byte) => (bin += String.fromCharCode(byte)))
    return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
  }

  const sha256Hex = async (input: string) => {
    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input))
    return Array.from(new Uint8Array(digest)).map((byte) => byte.toString(16).padStart(2, "0")).join("")
  }

  const hmacHex = async (secret: string, value: string) => {
    const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"])
    const signature = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(value))
    return Array.from(new Uint8Array(signature)).map((byte) => byte.toString(16).padStart(2, "0")).join("")
  }

  const getClientIds = async (): Promise<{ ipHash?: string; fpHash?: string }> => {
    try {
      const controller = new AbortController()
      const timer = setTimeout(() => controller.abort(), 1500)
      const res = await fetch("https://api.ipify.org?format=json", { signal: controller.signal })
      clearTimeout(timer)
      const { ip } = (await res.json()) as { ip: string }
      if (ip) return { ipHash: await sha256Hex(ip) }
    } catch {
      // ipify blocked -> fall back to device fingerprint
    }
    const fingerprint = [
      navigator.userAgent,
      `${screen.width}x${screen.height}`,
      Intl.DateTimeFormat().resolvedOptions().timeZone,
      navigator.language,
      String(navigator.hardwareConcurrency || 0),
    ].join("|")
    return { fpHash: await sha256Hex(fingerprint) }
  }

  const initContactForms = () => {
    const wrappers = Array.from(document.querySelectorAll<HTMLElement>("[data-contact-form]"))

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.inited) return
      wrapper.dataset.inited = "true"

      const form = wrapper.querySelector<HTMLFormElement>(".contact-form")!
      const alertBox = wrapper.querySelector<HTMLElement>(".contact-alert")!
      const submit = wrapper.querySelector<HTMLButtonElement>("button[type=\"submit\"]")!
      const label = wrapper.querySelector<HTMLElement>(".contact-label")!
      const loading = wrapper.querySelector<HTMLElement>(".contact-loading")!
      let alertTimer: ReturnType<typeof setTimeout> | undefined

      const showAlert = (type: "success" | "error", message: string) => {
        alertBox.textContent = message
        alertBox.className = `alert ${type === "success" ? "alert-success" : "alert-error"} mb-4 transition duration-300 ease-in-out`
        clearTimeout(alertTimer)
        alertTimer = setTimeout(() => alertBox.classList.add("hidden"), 3000)
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault()
        if (!ENDPOINT || !SECRET) {
          showAlert("error", "Contact form is not configured yet.")
          return
        }
        submit.disabled = true
        label.textContent = "Sending"
        loading.classList.remove("hidden")

        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>

        try {
          const { ipHash, fpHash } = await getClientIds()
          const payload = {
            requestId: crypto.randomUUID(),
            nonce: crypto.randomUUID(),
            timestamp: Date.now(),
            origin: window.location.origin,
            name: data.from_name,
            email: data.from_email,
            message: data.message,
            subject: `Contact from ${data.from_name}`,
            ipHash: ipHash || "",
            fpHash: fpHash || "",
            userAgent: navigator.userAgent,
          }
          const encoded = b64url(new TextEncoder().encode(JSON.stringify(payload)))
          const signature = await hmacHex(SECRET, encoded)

          const res = await fetch(ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ payload: encoded, signature }),
          })
          const result = (await res.json()) as { status?: string; reason?: string }

          if (result.status === "sent") {
            showAlert("success", "Your message has been sent successfully! We will get back to you soon.")
            form.reset()
          } else if (result.reason === "rate_limited") {
            showAlert("error", "You have reached the daily limit of 3 messages. Please try again tomorrow.")
          } else {
            showAlert("error", "Something went wrong! Please try again.")
          }
        } catch {
          showAlert("error", "Something went wrong! Please try again.")
        } finally {
          submit.disabled = false
          label.textContent = "Send"
          loading.classList.add("hidden")
        }
      })
    })
  }

  const win = window as unknown as Record<string, unknown>
  if (!win.__contactInited) {
    win.__contactInited = true
    document.addEventListener("astro:page-load", initContactForms)
  }
</script>