---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  modalId: string
  provider: string
  dateFormatted: string
  name: string
  image: ImageMetadata
  imageAlt?: string
  link: string
}

const { modalId, provider, dateFormatted, name, image, imageAlt, link } = Astro.props
---

<dialog
  id={modalId}
  class="modal fixed inset-0 z-50 bg-black/60 backdrop-blur-sm p-0 max-w-none max-h-none w-full h-full flex items-center justify-center"
>
  <div
    class="modal-content bg-white dark:bg-neutral-900 border border-black/20 dark:border-white/20 rounded-xl shadow-2xl w-[95%] max-w-2xl p-6 relative max-h-[90vh] overflow-y-auto transition-all duration-220 ease-out"
  >
    <div id="modal-content-loaded">
      <div class="flex items-center justify-between mb-3">
        <span
          class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold leading-5 text-white capitalize bg-sky-700 dark:bg-sky-600"
        >
          {provider}
        </span>
        <p class="font-mono text-xs opacity-75">{dateFormatted}</p>
      </div>
      <h3 class="font-bold text-base md:text-lg text-black dark:text-white mb-4">{name}</h3>
      <Image
        src={image}
        alt={imageAlt || name}
        width={640}
        height={480}
        quality={90}
        loading="lazy"
        class="w-full h-auto max-h-[55vh] object-contain m-auto mb-5 rounded-xl border border-black/10 dark:border-white/10"
      />
      <div class="flex flex-col w-full gap-2.5">
        <a
          href={link}
          target="_blank"
          rel="noreferrer"
          class="w-full font-semibold py-2.5 px-4 text-center text-xs md:text-sm text-white dark:text-black bg-black dark:bg-white rounded-xl shadow-sm hover:opacity-90 transition-all duration-220 ease-out active:scale-95"
        >
          View Certificate
        </a>
        <button
          type="button"
          class="w-full font-semibold py-2.5 px-4 text-center text-xs md:text-sm text-black dark:text-white border border-black/30 dark:border-white/30 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-220 ease-out active:scale-95 close-modal-btn"
        >
          Close
        </button>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button class="absolute inset-0 w-full h-full cursor-default"></button>
  </form>
</dialog>
