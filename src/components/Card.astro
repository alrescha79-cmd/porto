---
interface Item {
  name: string
  image?: string
  alt?: string
}

type Props = {
  title: string
  items: Item[]
  featured?: boolean
}

const { title, items, featured = false } = Astro.props
const twoColumns = items.length >= 4
---

<div
  class="skills-card flex flex-col h-full rounded-xl border bg-white dark:bg-neutral-900 border-black/15 dark:border-white/20 p-5 shadow-sm transition-shadow duration-220 ease-out hover:shadow-md"
>
  <div class="flex items-baseline justify-between gap-3 mb-4 pb-3 border-b border-black/10 dark:border-white/15">
    <h2
      class:list={[
        "font-mono text-[11px] uppercase tracking-[0.14em] text-black/60 dark:text-white/60",
        featured && "text-black dark:text-white",
      ]}
    >
      {featured && (
        <span
          class="inline-block size-1.5 rounded-full bg-sky-700 dark:bg-sky-600 mr-2 align-baseline"
          aria-hidden="true"
        ></span>
      )}
      {title}
    </h2>
    <span class="font-mono text-[11px] text-black/40 dark:text-white/40 tabular-nums">
      {items.length}
    </span>
  </div>

  <ul
    class:list={[
      "grid gap-x-3 gap-y-1.5",
      twoColumns ? "grid-cols-2" : "grid-cols-1",
    ]}
  >
    {items.map((item) => (
      <li>
        <div
          class="skills-card-row group/row flex items-center gap-2.5 rounded-lg px-2 py-1.5 -mx-2 transition-colors duration-150 ease-out hover:bg-black/5 dark:hover:bg-white/10"
        >
          {item.image && (
            <img
              src={`/${item.image}`}
              alt=""
              loading="lazy"
              class="size-5 shrink-0 object-contain transition-transform duration-150 ease-out motion-safe:group-hover/row:scale-110"
            />
          )}
          <span
            class="text-sm leading-tight text-black/75 dark:text-white/75 transition-colors duration-150 ease-out group-hover/row:text-black dark:group-hover/row:text-white truncate"
          >
            {item.name}
          </span>
        </div>
      </li>
    ))}
  </ul>
</div>
