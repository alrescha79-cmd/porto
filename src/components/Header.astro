---
import { SITE, LINKS } from "../consts"
import { cn } from "../lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
import Container from "../components/Container.astro"
import { Image } from "astro:assets"
import logoImg from "../assets/logo.png"
---

<header class="w-full">
  <Container size="md">
    <div
      class="header-bar z-50 fixed top-0 left-0 right-0 flex justify-between md:justify-evenly items-center px-4 py-3 md:py-3.5 w-full bg-white/75 dark:bg-black/75 transition-all duration-200 ease-out backdrop-blur-md border-b border-black/[0.08] dark:border-white/[0.12]"
    >
      <div>
        <a
          href="/"
          class="flex gap-2.5 w-fit items-center font-semibold text-current hover:text-black dark:hover:text-white transition-all duration-200 ease-out group"
        >
          <div class="relative size-8 rounded-full overflow-hidden ring-1 ring-black/10 dark:ring-white/20 group-hover:scale-105 transition-transform duration-200 ease-out">
            <Image
              src={logoImg}
              alt="Anggun Caksono"
              class="rounded-full bg-black shrink-0 object-cover"
              width={32}
              height={32}
              quality={60}
              format="avif"
            />
          </div>
          <span class="font-bold text-sm md:text-base whitespace-nowrap tracking-tight text-black dark:text-white">
            {SITE.TITLE}
          </span>
        </a>
      </div>

      <!-- Desktop Nav (Inline Header) -->
      <nav class="hidden md:flex items-center">
        <ul class="flex items-center gap-1.5 p-1 rounded-full bg-black/[0.03] dark:bg-white/[0.06] border border-black/[0.06] dark:border-white/[0.1]">
          {
            LINKS.map((LINK) => {
              const isActive = pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF
              return (
                <li>
                  <a
                    href={LINK.HREF}
                    class={cn(
                      "h-8 rounded-full px-4 py-1 text-xs font-semibold tracking-wide",
                      "flex items-center justify-center gap-1.5",
                      "transition-all duration-200 ease-out",
                      isActive
                        ? "bg-black dark:bg-white text-white dark:text-black shadow-sm"
                        : "hover:bg-black/10 dark:hover:bg-white/15 text-black/70 dark:text-white/70 hover:text-black dark:hover:text-white"
                    )}
                  >
                    <span>{LINK.TEXT}</span>
                  </a>
                </li>
              )
            })
          }
        </ul>
      </nav>

      <div class="flex gap-2 items-center">
        <a
          href="/contact"
          aria-label={`Get in touch with ${SITE.TITLE}`}
          class={cn(
            "rounded-full px-3.5 py-1.5 text-xs font-semibold flex items-center justify-center",
            "border border-black/20 dark:border-white/25 shadow-xs",
            "transition-all duration-200 ease-out active:scale-95",
            pathname === "/contact" || "/" + subpath?.[0] === "/contact"
              ? "pointer-events-none bg-black dark:bg-white text-white dark:text-black"
              : "hover:bg-black/10 dark:hover:bg-white/20 text-black/80 dark:text-white/80 hover:text-black dark:hover:text-white"
          )}
        >
          Contact
        </a>

        <button
          id="header-theme-button"
          aria-label="Toggle light and dark theme"
          class={cn(
            "size-9 rounded-full p-2 flex items-center justify-center shrink-0 cursor-pointer",
            "bg-black/[0.03] dark:bg-white/[0.06] hover:bg-black/10 dark:hover:bg-white/20",
            "stroke-current border border-black/15 dark:border-white/20",
            "transition-all duration-200 ease-out active:scale-90"
          )}
        >
          <svg class="size-full block dark:hidden transition-transform duration-300 hover:rotate-45">
            <use href="/ui.svg#sun"></use>
          </svg>
          <svg class="size-full hidden dark:block transition-transform duration-300 hover:-rotate-12">
            <use href="/ui.svg#moon"></use>
          </svg>
        </button>
      </div>
    </div>
  </Container>

  <!-- Mobile Floating Bottom Nav (Dock) -->
  <nav
    class="md:hidden fixed bottom-4 left-0 right-0 w-[92%] max-w-sm mx-auto p-1.5 z-50 rounded-full bg-white/85 dark:bg-neutral-900/85 backdrop-blur-lg shadow-2xl border border-black/10 dark:border-white/15 transition-all duration-200 ease-out"
  >
    <ul class="flex justify-evenly items-center gap-1">
      {
        LINKS.map((LINK) => {
          const isActive = pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF
          return (
            <li class="flex-1 text-center">
              <a
                href={LINK.HREF}
                class={cn(
                  "py-2 px-2 rounded-full flex flex-col items-center justify-center transition-all duration-200 ease-out active:scale-95",
                  isActive
                    ? "bg-black dark:bg-white text-white dark:text-black shadow-md font-semibold"
                    : "hover:bg-black/5 dark:hover:bg-white/10 text-black/70 dark:text-white/70 hover:text-black dark:hover:text-white"
                )}
              >
                <svg class="size-4.5 fill-current">
                  <use href={`/navicon.svg#${LINK.ICON}`} />
                </svg>
                <span class="text-[10px] leading-tight font-medium mt-0.5">{LINK.TEXT}</span>
              </a>
            </li>
          )
        })
      }
    </ul>
  </nav>
</header>

<script>
  function updateHeaderOnScroll() {
    const headerEl = document.querySelector(".header-bar")
    if (!headerEl) return
    if (window.scrollY > 20) {
      headerEl.classList.add("header-scrolled")
    } else {
      headerEl.classList.remove("header-scrolled")
    }
  }

  function initHeaderScroll() {
    window.removeEventListener("scroll", updateHeaderOnScroll)
    window.addEventListener("scroll", updateHeaderOnScroll, { passive: true })
    updateHeaderOnScroll()
  }

  document.addEventListener("astro:page-load", initHeaderScroll)
</script>
