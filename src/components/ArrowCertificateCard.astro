---
import CertificateModal from "./CertificateModal.astro"

const { image, imageAlt, provider, date, name, link } = Astro.props

const dateFormatted = new Date(date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
})

const modalId = `modal-${name.replace(/[^a-zA-Z0-9]/g, "-").toLowerCase()}`
---

<div
  class="certificate-card group p-4 rounded-xl border border-black/15 dark:border-white/20 hover:bg-black/5 hover:dark:bg-white/10 transition-all duration-220 ease-out cursor-pointer active:scale-[0.99]"
  data-modal-id={modalId}
>
  <div class="w-full flex flex-col items-start gap-2">
    <div class="flex justify-between items-center w-full">
      <span class="text-xs font-mono opacity-75 px-2.5 py-0.5 rounded-full bg-black/5 dark:bg-white/10">
        {date}
      </span>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold leading-5 text-white capitalize bg-sky-700 dark:bg-sky-600">
        {provider}
      </span>
    </div>
    <p class="text-sm md:text-base font-bold text-black dark:text-white group-hover:text-black dark:group-hover:text-white transition-colors duration-220 ease-out line-clamp-2">
      {name}
    </p>
  </div>

  <CertificateModal
    modalId={modalId}
    provider={provider}
    dateFormatted={dateFormatted}
    name={name}
    image={image}
    imageAlt={imageAlt}
    link={link}
  />
</div>

<script src="../js/certificate-card.ts"></script>
