---
import { Image } from "astro:assets"

const { image, imageAlt, provider, date, name, link } = Astro.props

const dateFormatted = new Date(date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
})

const modalId = `modal-${name.replace(/\s+/g, "-").toLowerCase()}`
---

<div
  class="certificate-card mb-4 col-span-12 sm:col-span-6 lg:col-span-4 border p-4 rounded-lg shadow-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out cursor-pointer"
  data-modal-id={modalId}
>
  <div
    id="certificate-content"
    class="w-full text-left block card-content hidden"
  >
    <div class="w-full flex flex-col items-center md:items-start">
      <div class="flex justify-between w-full">
        <div
          class="text-xs font-normal opacity-75 px-2 rounded-full content-center bg-black/5 dark:bg-white/10"
        >
          {date}
        </div>
        <div class="px-2 py-0.5 rounded-full text-sm text-white bg-sky-700">
          {provider}
        </div>
      </div>
    </div>
    <div class="flex flex-col md:flex-row md:gap-4 items-center w-full">
      <div class="flex my-1 text-base font-bold w-full">
        <span class="link-underline link-underline-black">
          {name}
        </span>
      </div>
    </div>
  </div>

  <!-- Skeleton loading -->
  <div id="skeleton-loading" class="skeleton-card">
    <div class="w-full flex flex-col items-center md:items-start">
      <div class="flex justify-between w-full">
        <div
          class="text-xs font-normal h-6 w-24 rounded-full bg-gray-300 dark:bg-gray-700 skeleton"
        >
        </div>
        <div
          class="h-6 w-24 rounded-full bg-gray-300 dark:bg-gray-700 skeleton"
        >
        </div>
      </div>
    </div>
    <div class="flex flex-col md:flex-row md:gap-4 items-center w-full mt-2">
      <div class="h-6 w-full bg-gray-300 dark:bg-gray-700 rounded skeleton">
      </div>
    </div>
  </div>

  <!-- Modal structure -->
  <dialog
    id={modalId}
    class="modal fixed inset-0 z-50 bg-black/60 backdrop-blur-sm p-0 max-w-none max-h-none w-full h-full flex items-center justify-center"
  >
    <div
      class="modal-content bg-white dark:bg-neutral-900 border border-black/20 dark:border-white/20 rounded-xl shadow-2xl w-[95%] max-w-2xl p-6 relative max-h-[90vh] overflow-y-auto transition-all duration-220 ease-out"
    >
      <div id="modal-content-loaded">
        <div class="flex items-center justify-between mb-3">
          <span
            class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold leading-5 text-white capitalize bg-sky-700 dark:bg-sky-600"
          >
            {provider}
          </span>
          <p class="font-mono text-xs opacity-75">{dateFormatted}</p>
        </div>
        <h3 class="font-bold text-base md:text-lg text-black dark:text-white mb-4">{name}</h3>
        <Image
          src={image}
          alt={imageAlt || name}
          width={640}
          height={480}
          quality={90}
          loading="lazy"
          class="w-full h-auto max-h-[55vh] object-contain m-auto mb-5 rounded-xl border border-black/10 dark:border-white/10"
        />
        <div class="flex flex-col w-full gap-2.5">
          <a
            href={link}
            target="_blank"
            rel="noreferrer"
            class="w-full font-semibold py-2.5 px-4 text-center text-xs md:text-sm text-white dark:text-black bg-black dark:bg-white rounded-xl shadow-sm hover:opacity-90 transition-all duration-220 ease-out active:scale-95"
          >
            View Certificate
          </a>
          <button
            type="button"
            class="w-full font-semibold py-2.5 px-4 text-center text-xs md:text-sm text-black dark:text-white border border-black/30 dark:border-white/30 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-220 ease-out active:scale-95 close-modal-btn"
          >
            Close
          </button>
        </div>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button class="absolute inset-0 w-full h-full cursor-default"></button>
    </form>
  </dialog>
</div>

<!-- Import the styles and scripts -->
<script src="../js/certificate-card.ts"></script>
