---
type Props = {
  text: string
  icon: string
  href: string
}

const { text, icon, href } = Astro.props
---

<a href={href} target="_blank" rel="noopener noreferrer" class="w-fit px-3 py-1.5 group rounded-xl border flex gap-2 items-center border-black/15 dark:border-white/20 hover:bg-black/5 hover:dark:bg-white/10 transition-all duration-220 ease-out active:scale-95">
  <svg height={18} width={18}>
    <use href={`/stack.svg#${icon}`}></use>
  </svg>
  <span class="text-xs md:text-sm font-medium text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white transition-colors duration-220 ease-out">
    {text}
  </span>
</a>