---
import CertificateCard from "./CertificateCard.astro"
import type { ImageMetadata } from "astro"

interface Certificate {
  image: ImageMetadata
  provider: string
  date: string
  name: string
  link?: string
  pinned?: boolean
}

type Props = {
  certificates: Certificate[]
}

const { certificates } = Astro.props
const providers = [...new Set(certificates.map((cert) => cert.provider))]
---

<div class="w-full max-w-4xl mx-auto px-4 mb-8">
  <div class="flex flex-col items-start w-full gap-1 mb-6">
    <h2 class="text-2xl md:text-3xl font-bold dark:text-white text-black tracking-tight">Certifications</h2>
    <p class="text-sm md:text-base text-black/70 dark:text-white/70">
      Verified credentials from industry programs, platforms, and institutions.
    </p>
  </div>
  <div class="w-full py-3.5 sticky top-14 bg-white/85 dark:bg-black/85 backdrop-blur-md z-20 border-y border-black/[0.08] dark:border-white/[0.12]">
    <label class="block text-xs font-bold uppercase tracking-wider text-black/60 dark:text-white/60 mb-2.5">
      Filter by Provider
    </label>
    <div class="flex flex-wrap gap-1.5 w-full">
      {providers.map((provider) => (
        <button
          data-cert-filter={provider}
          aria-pressed="false"
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold flex gap-2 items-center border border-black/10 dark:border-white/15 bg-black/[0.03] dark:bg-white/[0.06] hover:bg-black/10 hover:dark:bg-white/15 transition-all duration-200 ease-out cursor-pointer active:scale-95 text-black/80 dark:text-white/80"
        >
          <svg class="size-3.5 fill-black/60 dark:fill-white/60 transition-colors duration-200 ease-out shrink-0">
            <use href="/ui.svg#square" class="filter-square block" />
            <use href="/ui.svg#square-check" class="filter-check hidden" />
          </svg>
          <span>{provider}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<div
  class="animate px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 w-full max-w-6xl mx-auto"
>
  {
    certificates.map((cert) => (
      <div data-cert-card data-provider={cert.provider}>
        <CertificateCard
          image={cert.image}
          provider={cert.provider}
          date={cert.date}
          name={cert.name}
          link={cert.link}
          pinned={cert.pinned}
        />
      </div>
    ))
  }
</div>

<div class="w-full max-w-4xl mx-auto mt-8 mb-2 px-4">
  <p id="cert-count" class="text-xs font-mono font-semibold text-center uppercase tracking-wider text-black/60 dark:text-white/60">
    Showing {certificates.length} of {certificates.length} Certificates
  </p>
</div>

<div class="w-full max-w-4xl mx-auto py-4 px-4">
  <div id="cert-pager" class="flex flex-wrap justify-center items-center gap-2"></div>
</div>

<script>
  import { ITEMS_PER_PAGE, clampPage, getPageNumbers } from "../lib/pager"
  import { toggleFilterButton } from "../lib/filter"

  function initCertificatesView() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-cert-card]"))
    const filterButtons = Array.from(document.querySelectorAll<HTMLElement>("[data-cert-filter]"))
    const counter = document.getElementById("cert-count")
    const pager = document.getElementById("cert-pager")
    if (!cards.length || !counter || !pager) return

    const selectedProviders = new Set<string>()
    let page = 1

    function filtered() {
      if (selectedProviders.size === 0) return cards
      return cards.filter((card) => selectedProviders.has(card.dataset.provider!))
    }

    function renderCards() {
      const items = filtered()
      const total = Math.max(1, Math.ceil(items.length / ITEMS_PER_PAGE))
      page = clampPage(page, total)
      const start = (page - 1) * ITEMS_PER_PAGE

      cards.forEach((card) => {
        const matches =
          selectedProviders.size === 0 || selectedProviders.has(card.dataset.provider!)
        const idx = items.indexOf(card)
        const inPage = idx >= start && idx < start + ITEMS_PER_PAGE
        card.classList.toggle("hidden", !(matches && inPage))
      })

      const shown = Math.min(ITEMS_PER_PAGE, Math.max(0, items.length - start))
      counter!.textContent = `Showing ${shown} of ${items.length} Certificates`
      renderPager(total)
      renderFilters()
    }

    function renderFilters() {
      filterButtons.forEach((btn) => {
        toggleFilterButton(btn, selectedProviders.has(btn.dataset.certFilter!))
      })
    }

    function renderPager(total: number) {
      const numbers = getPageNumbers(total, page)
      let html = `<button type="button" class="px-3.5 py-1.5 rounded-full text-xs font-semibold border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 ease-out active:scale-95 disabled:opacity-30 disabled:pointer-events-none cursor-pointer text-black dark:text-white" data-pager="prev" ${page === 1 ? "disabled" : ""}>&larr; Prev</button>`
      for (const n of numbers) {
        if (n === "...") {
          html += `<span class="px-2 py-1 text-xs text-black/40 dark:text-white/40">...</span>`
        } else {
          const isActive = page === n
          html += `<button type="button" class="min-w-[34px] h-8.5 px-3 py-1.5 rounded-full text-xs font-semibold border transition-all duration-200 ease-out active:scale-95 cursor-pointer ${isActive ? "bg-black text-white dark:bg-white dark:text-black border-black dark:border-white shadow-xs" : "border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/10 text-black dark:text-white"}" data-pager="page" data-page="${n}">${n}</button>`
        }
      }
      html += `<button type="button" class="px-3.5 py-1.5 rounded-full text-xs font-semibold border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 ease-out active:scale-95 disabled:opacity-30 disabled:pointer-events-none cursor-pointer text-black dark:text-white" data-pager="next" ${page === total ? "disabled" : ""}>Next &rarr;</button>`
      pager!.innerHTML = html

      pager!.querySelectorAll("button").forEach((btn) => {
        btn.addEventListener("click", () => {
          const action = btn.dataset.pager
          if (action === "prev") {
            page -= 1
          } else if (action === "next") {
            page += 1
          } else {
            page = Number(btn.dataset.page)
          }
          renderCards()
          window.scrollTo({ top: 0, behavior: "smooth" })
        })
      })
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const provider = btn.dataset.certFilter!
        if (selectedProviders.has(provider)) {
          selectedProviders.delete(provider)
        } else {
          selectedProviders.add(provider)
        }
        page = 1
        renderCards()
      })
    })

    renderCards()
  }

  document.addEventListener("astro:page-load", initCertificatesView)
</script>
