---
import type { CollectionEntry } from "astro:content"
import ArrowCard from "./ArrowCard.astro"

type Props = {
  tags: string[]
  data: CollectionEntry<"projects">[]
}

const { tags, data } = Astro.props
---

<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
  <div class="col-span-3 sm:col-span-1">
    <div class="sticky top-20 p-4 rounded-2xl border border-black/[0.08] dark:border-white/[0.12] bg-white dark:bg-neutral-900/40 shadow-xs">
      <div class="text-xs font-bold uppercase tracking-wider mb-3 text-black/70 dark:text-white/70">
        Filter by Tag
      </div>
      <ul class="flex flex-wrap sm:flex-col gap-1.5">
        {tags.map((tag) => (
          <li>
            <button
              type="button"
              data-project-filter={tag}
              aria-pressed="false"
              class="w-full px-3 py-1.5 rounded-full text-xs font-semibold flex gap-2 items-center border border-black/10 dark:border-white/15 bg-black/[0.03] dark:bg-white/[0.06] hover:bg-black/10 hover:dark:bg-white/15 transition-all duration-200 ease-out cursor-pointer active:scale-95 text-black/80 dark:text-white/80"
            >
              <svg class="size-3.5 fill-black/60 dark:fill-white/60 transition-colors duration-200 ease-out shrink-0">
                <use href="/ui.svg#square" class="filter-square block" />
                <use href="/ui.svg#square-check" class="filter-check hidden" />
              </svg>
              <span class="truncate">{tag}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="col-span-3 sm:col-span-2">
    <div class="flex flex-col">
      <div id="projects-count" class="text-xs font-mono font-semibold uppercase tracking-wider mb-3.5 text-black/60 dark:text-white/60">
        SHOWING {data.length} OF {data.length} PROJECTS
      </div>
      <ul class="flex flex-col gap-3.5">
        {
          data.map((project) => (
            <li data-project-tags={project.data.tags.map((t) => t.toLowerCase()).join(" ")}>
              <ArrowCard entry={project} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  import { toggleFilterButton } from "../lib/filter"

  function initProjectsFilter() {
    const filterButtons = Array.from(document.querySelectorAll<HTMLElement>("[data-project-filter]"))
    const listItems = Array.from(document.querySelectorAll<HTMLElement>("[data-project-tags]"))
    const counter = document.getElementById("projects-count")
    if (!filterButtons.length || !listItems.length || !counter) return

    const selected = new Set<string>()

    function render() {
      let visible = 0
      listItems.forEach((li) => {
        const tags = li.getAttribute("data-project-tags")!.split(" ")
        const show = Array.from(selected).every((tag) => tags.includes(tag.toLowerCase()))
        li.classList.toggle("hidden", !show)
        if (show) visible++
      })

      counter!.textContent = `SHOWING ${visible} OF ${listItems.length} PROJECTS`

      filterButtons.forEach((btn) => {
        const tag = btn.dataset.projectFilter!
        toggleFilterButton(btn, selected.has(tag))
      })
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tag = btn.dataset.projectFilter!
        if (selected.has(tag)) {
          selected.delete(tag)
        } else {
          selected.add(tag)
        }
        render()
      })
    })
  }

  document.addEventListener("astro:page-load", initProjectsFilter)
</script>
