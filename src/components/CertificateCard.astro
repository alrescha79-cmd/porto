---
import { Image } from "astro:assets"
import CertificateModal from "./CertificateModal.astro"

const { image, provider, date, name, link, pinned } = Astro.props

const dateFormatted = new Date(date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
})

const modalId = `modal-${name.replace(/[^a-zA-Z0-9]/g, "-").toLowerCase()}`
---

<div
  class="certificate-card group flex flex-col justify-between h-full border p-4 rounded-2xl shadow-sm hover:shadow-md hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-all duration-220 ease-out cursor-pointer active:scale-[0.99]"
  data-modal-id={modalId}
>
  <div class="w-full text-left flex flex-col h-full">
    <div class="w-full aspect-[4/3] rounded-xl overflow-hidden bg-neutral-100 dark:bg-neutral-800/80 mb-3.5 border border-black/5 dark:border-white/5 flex items-center justify-center">
      <Image
        src={image}
        alt={name}
        width={400}
        height={300}
        quality={75}
        class="w-full h-full object-contain p-1.5 transition-transform duration-220 ease-out group-hover:scale-[1.03]"
        loading="lazy"
      />
    </div>
    <div class="flex items-center justify-between mb-2.5">
      <span
        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold leading-5 text-white capitalize bg-sky-700 dark:bg-sky-600"
      >
        {provider}
      </span>
      <div class="flex items-center gap-2">
        {pinned && <span class="font-mono font-bold text-xs text-amber-600 dark:text-amber-400" title="Featured">Featured</span>}
        <p class="font-mono text-xs font-normal opacity-75">
          {dateFormatted}
        </p>
      </div>
    </div>
    <p class="text-sm md:text-base font-bold text-black dark:text-white line-clamp-2 leading-snug">
      {name}
    </p>
  </div>

  <CertificateModal
    modalId={modalId}
    provider={provider}
    dateFormatted={dateFormatted}
    name={name}
    image={image}
    link={link}
  />
</div>

<script src="../js/certificate-card.ts"></script>
